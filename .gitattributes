# Disable autocrlf on generated files, they always generate with LF
# Add any extra files or paths here to make git stop saying they
# are changed when only line endings change.
src/generated/**/.cache/* text eol=lf
src/generated/**/*.json text eol=lf

# 脚本必须保持 LF，否则 Linux/macOS 上跑不起来
gradlew text eol=lf
*.sh text eol=lf

# Windows 批处理保持 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件不做行尾转换
*.jar binary
*.png binary
*.jpg binary
*.ogg binary
*.zip binary

# NeoForge 模板由 moddev 读入做占位符替换，保持 LF
src/main/templates/** text eol=lf
